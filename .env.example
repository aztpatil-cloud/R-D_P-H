# Supabase (create a dedicated P&H R&D project before enabling authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — server-side only; never expose this value to the browser
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Google Drive OAuth — configure in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Encrypt stored Google OAuth refresh tokens with a 32-byte key (base64)
TOKEN_ENCRYPTION_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
